{
    "name": "scopos/guidemap-pro",
    "description": "GuideMap Pro core library: framework-free parsing and storage of Google Takeout Maps contributions.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "GuideMap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GuideMap\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "smoke": "php scripts/parse-takeout.php fixtures/takeout-sample.zip"
    }
}
